# Salin file ini menjadi .env lalu sesuaikan nilainya.

# --- Keamanan ---
SECRET_KEY=ganti-dengan-string-acak-panjang
JWT_SECRET=ganti-juga-dengan-string-acak-panjang
JWT_EXPIRES_HOURS=12

# --- Basis data ---
# DB_ENGINE=mysql  -> memakai MariaDB/MySQL (sesuai SRS)
# DB_ENGINE=sqlite -> mode development tanpa server database
DB_ENGINE=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bisa
DB_USER=root
DB_PASSWORD=

# Alternatif: timpa seluruh koneksi dengan satu URL.
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/bisa?charset=utf8mb4

# --- Aplikasi ---
# Isi otomatis data master + akun demo saat basis data masih kosong.
AUTO_SEED=true
